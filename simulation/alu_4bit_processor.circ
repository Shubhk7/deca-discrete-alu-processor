<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v3.8.0 (https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Splitter">
      <a name="facing" val="west"/>
      <a name="fanout" val="4"/>
      <a name="incoming" val="4"/>
    </tool>
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
    <tool name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="4"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="8"/>

  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
  </toolbar>

  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>

    <!-- Clock, Reset and Load Controls -->
    <comp lib="0" loc="(80,600)" name="Clock">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="0" loc="(80,640)" name="Pin">
      <a name="label" val="RST"/>
    </comp>
    <comp lib="0" loc="(80,560)" name="Pin">
      <a name="label" val="LOAD_EN"/>
    </comp>

    <!-- 4-Bit Inputs: Operand A, Operand B, Opcode -->
    <comp lib="0" loc="(120,160)" name="Pin">
      <a name="label" val="INPUT_A"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(120,240)" name="Pin">
      <a name="label" val="INPUT_B"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(120,400)" name="Pin">
      <a name="label" val="OPCODE"/>
      <a name="width" val="3"/>
    </comp>

    <!-- Registers A and B -->
    <comp lib="4" loc="(200,130)" name="Register">
      <a name="label" val="REG_A"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="4" loc="(200,210)" name="Register">
      <a name="label" val="REG_B"/>
      <a name="width" val="4"/>
    </comp>

    <!-- ALU Core Subcircuit / Logic Block -->
    <!-- Op 0: Addition (A + B) -->
    <comp lib="3" loc="(420,140)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 1: Subtraction (A - B) -->
    <comp lib="3" loc="(420,210)" name="Subtractor">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 2: Bitwise AND -->
    <comp lib="1" loc="(420,270)" name="AND Gate">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 3: Bitwise OR -->
    <comp lib="1" loc="(420,330)" name="OR Gate">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 4: Bitwise XOR -->
    <comp lib="1" loc="(420,390)" name="XOR Gate">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 5: Bitwise NOT A -->
    <comp lib="1" loc="(410,450)" name="NOT Gate">
      <a name="width" val="4"/>
    </comp>
    <!-- Op 6: Increment A (A + 1) -->
    <comp lib="3" loc="(420,510)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(360,530)" name="Constant">
      <a name="value" val="0x1"/>
      <a name="width" val="4"/>
    </comp>
    <!-- Op 7: Clear (0000) -->
    <comp lib="0" loc="(400,570)" name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="4"/>
    </comp>

    <!-- 8:1 Multiplexer (4-bit data) -->
    <comp lib="2" loc="(570,300)" name="Multiplexer">
      <a name="select" val="3"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Result / Accumulator Register -->
    <comp lib="4" loc="(660,270)" name="Register">
      <a name="label" val="ACC_RESULT"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Output Displays & Pins -->
    <comp lib="0" loc="(780,300)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="RESULT_OUT"/>
      <a name="output" val="true"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="5" loc="(780,210)" name="Hex Digit Display">
      <a name="label" val="HEX_DISP"/>
    </comp>

    <!-- Status Flags Logic -->
    <!-- Carry Flag from Adder -->
    <comp lib="0" loc="(450,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="FLAG_CARRY"/>
      <a name="output" val="true"/>
    </comp>
    <!-- Zero Flag: Comparator == 0 -->
    <comp lib="3" loc="(760,380)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(700,400)" name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(800,380)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="FLAG_ZERO"/>
      <a name="output" val="true"/>
    </comp>

    <!-- Wiring Connections -->
    <!-- Register A Wiring -->
    <wire from="(120,160)" to="(200,160)"/>
    <wire from="(260,160)" to="(300,160)"/>
    <!-- Distribute A to ALU blocks -->
    <wire from="(300,160)" to="(300,130)"/>
    <wire from="(300,130)" to="(380,130)"/>
    <wire from="(300,160)" to="(300,200)"/>
    <wire from="(300,200)" to="(380,200)"/>
    <wire from="(300,200)" to="(300,260)"/>
    <wire from="(300,260)" to="(370,260)"/>
    <wire from="(300,260)" to="(300,320)"/>
    <wire from="(300,320)" to="(370,320)"/>
    <wire from="(300,320)" to="(300,380)"/>
    <wire from="(300,380)" to="(360,380)"/>
    <wire from="(300,380)" to="(300,450)"/>
    <wire from="(300,450)" to="(380,450)"/>
    <wire from="(300,450)" to="(300,500)"/>
    <wire from="(300,500)" to="(380,500)"/>

    <!-- Register B Wiring -->
    <wire from="(120,240)" to="(200,240)"/>
    <wire from="(260,240)" to="(320,240)"/>
    <!-- Distribute B to ALU blocks -->
    <wire from="(320,240)" to="(320,150)"/>
    <wire from="(320,150)" to="(380,150)"/>
    <wire from="(320,240)" to="(320,220)"/>
    <wire from="(320,220)" to="(380,220)"/>
    <wire from="(320,240)" to="(320,280)"/>
    <wire from="(320,280)" to="(370,280)"/>
    <wire from="(320,280)" to="(320,340)"/>
    <wire from="(320,340)" to="(370,340)"/>
    <wire from="(320,340)" to="(320,400)"/>
    <wire from="(320,400)" to="(360,400)"/>

    <!-- Incrementer Constant 1 connection -->
    <wire from="(360,530)" to="(380,520)"/>

    <!-- MUX Input Connections (D0 to D7) -->
    <!-- D0: Add -->
    <wire from="(420,140)" to="(500,140)"/>
    <wire from="(500,140)" to="(500,260)"/>
    <wire from="(500,260)" to="(530,260)"/>
    <!-- D1: Sub -->
    <wire from="(420,210)" to="(490,210)"/>
    <wire from="(490,210)" to="(490,270)"/>
    <wire from="(490,270)" to="(530,270)"/>
    <!-- D2: AND -->
    <wire from="(420,270)" to="(480,270)"/>
    <wire from="(480,270)" to="(480,280)"/>
    <wire from="(480,280)" to="(530,280)"/>
    <!-- D3: OR -->
    <wire from="(420,330)" to="(480,330)"/>
    <wire from="(480,330)" to="(480,290)"/>
    <wire from="(480,290)" to="(530,290)"/>
    <!-- D4: XOR -->
    <wire from="(420,390)" to="(490,390)"/>
    <wire from="(490,390)" to="(490,300)"/>
    <wire from="(490,300)" to="(530,300)"/>
    <!-- D5: NOT -->
    <wire from="(410,450)" to="(500,450)"/>
    <wire from="(500,450)" to="(500,310)"/>
    <wire from="(500,310)" to="(530,310)"/>
    <!-- D6: INC -->
    <wire from="(420,510)" to="(510,510)"/>
    <wire from="(510,510)" to="(510,320)"/>
    <wire from="(510,320)" to="(530,320)"/>
    <!-- D7: CLEAR -->
    <wire from="(400,570)" to="(520,570)"/>
    <wire from="(520,570)" to="(520,330)"/>
    <wire from="(520,330)" to="(530,330)"/>

    <!-- Opcode select to MUX -->
    <wire from="(120,400)" to="(550,400)"/>
    <wire from="(550,340)" to="(550,400)"/>

    <!-- Carry Out flag -->
    <wire from="(400,120)" to="(450,120)"/>

    <!-- MUX Output to Accumulator Register -->
    <wire from="(570,300)" to="(660,300)"/>

    <!-- Accumulator Output to Outputs & Zero Comparator -->
    <wire from="(720,300)" to="(740,300)"/>
    <wire from="(740,300)" to="(780,300)"/>
    <wire from="(740,300)" to="(740,250)"/>
    <wire from="(740,250)" to="(780,250)"/>
    <wire from="(740,300)" to="(740,370)"/>
    <wire from="(740,370)" to="(720,370)"/>

    <!-- Zero Comparator -->
    <wire from="(760,380)" to="(800,380)"/>

    <!-- Clock and Control distribution to registers -->
    <wire from="(80,600)" to="(160,600)"/>
    <wire from="(160,600)" to="(160,180)"/>
    <wire from="(160,180)" to="(200,180)"/>
    <wire from="(160,180)" to="(160,260)"/>
    <wire from="(160,260)" to="(200,260)"/>
    <wire from="(160,260)" to="(160,320)"/>
    <wire from="(160,320)" to="(660,320)"/>

    <wire from="(80,560)" to="(180,560)"/>
    <wire from="(180,560)" to="(180,200)"/>
    <wire from="(180,200)" to="(200,200)"/>
    <wire from="(180,200)" to="(180,280)"/>
    <wire from="(180,280)" to="(200,280)"/>
    <wire from="(180,280)" to="(180,340)"/>
    <wire from="(180,340)" to="(660,340)"/>
  </circuit>
</project>
