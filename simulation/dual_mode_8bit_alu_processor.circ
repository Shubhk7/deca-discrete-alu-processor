<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v3.8.0 (https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Splitter">
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="incoming" val="8"/>
    </tool>
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
    <tool name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="8"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="8"/>

  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
  </toolbar>

  <circuit name="main">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="main"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="2.0"/>

    <!-- Clock, Reset, and Load Controls -->
    <comp lib="0" loc="(80,680)" name="Clock">
      <a name="label" val="CLK"/>
    </comp>
    <comp lib="0" loc="(80,720)" name="Pin">
      <a name="label" val="RST"/>
    </comp>
    <comp lib="0" loc="(80,640)" name="Pin">
      <a name="label" val="LOAD_EN"/>
    </comp>

    <!-- Mode Selector: 0 = 8-Bit Compute Mode, 1 = 4-Bit Hardware Verify Mode -->
    <comp lib="0" loc="(100,80)" name="Pin">
      <a name="label" val="MODE_COMPUTE_VERIFY"/>
    </comp>

    <!-- 8-Bit Operands A & B, and 3-Bit Opcode -->
    <comp lib="0" loc="(100,160)" name="Pin">
      <a name="label" val="OPERAND_A_8BIT"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(100,240)" name="Pin">
      <a name="label" val="OPERAND_B_8BIT"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(100,340)" name="Pin">
      <a name="label" val="OPCODE"/>
      <a name="width" val="3"/>
    </comp>

    <!-- 8-Bit Registers A and B -->
    <comp lib="4" loc="(180,130)" name="Register">
      <a name="label" val="REG_A"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="4" loc="(180,210)" name="Register">
      <a name="label" val="REG_B"/>
      <a name="width" val="8"/>
    </comp>

    <!-- Bus Splitters for A and B (Lower 4 bits vs Upper 4 bits) -->
    <comp lib="0" loc="(260,160)" name="Splitter">
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="incoming" val="8"/>
    </comp>
    <comp lib="0" loc="(260,240)" name="Splitter">
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="incoming" val="8"/>
    </comp>

    <!-- Mode Multiplexers: In Mode 0 routes A[7..4], in Mode 1 routes A[3..0] -->
    <comp lib="2" loc="(360,180)" name="Multiplexer">
      <a name="width" val="4"/>
    </comp>
    <comp lib="2" loc="(360,260)" name="Multiplexer">
      <a name="width" val="4"/>
    </comp>

    <!-- Custom 4-Bit ALU Core (Lower Nibble) -->
    <comp lib="3" loc="(480,140)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,200)" name="AND Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,260)" name="OR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,320)" name="XOR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="2" loc="(570,200)" name="Multiplexer">
      <a name="select" val="3"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Upper Nibble / 74LS181 Commercial ALU Model -->
    <comp lib="3" loc="(480,420)" name="Adder">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,480)" name="AND Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,540)" name="OR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(480,600)" name="XOR Gate">
      <a name="width" val="4"/>
    </comp>
    <comp lib="2" loc="(570,480)" name="Multiplexer">
      <a name="select" val="3"/>
      <a name="width" val="4"/>
    </comp>

    <!-- Hardware Equivalence Verifier: 74LS85 4-Bit Magnitude Comparator -->
    <comp lib="3" loc="(680,260)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="0" loc="(740,260)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="VERIFY_PASS_MATCH"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="5" loc="(760,260)" name="LED">
      <a name="color" val="#00f028"/>
      <a name="label" val="LED_PASS"/>
    </comp>

    <!-- 8-Bit Bus Combiner: Merges Lower Nibble (Custom) & Upper Nibble (74LS181) -->
    <comp lib="0" loc="(660,370)" name="Splitter">
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="facing" val="west"/>
      <a name="incoming" val="8"/>
    </comp>

    <!-- 8-Bit Result / Accumulator Register -->
    <comp lib="4" loc="(700,340)" name="Register">
      <a name="label" val="ACC_RESULT_8BIT"/>
      <a name="width" val="8"/>
    </comp>

    <!-- 8-Bit Output Pins and Displays -->
    <comp lib="0" loc="(820,370)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="RESULT_8BIT_OUT"/>
      <a name="output" val="true"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="5" loc="(820,290)" name="Hex Digit Display">
      <a name="label" val="HEX_UPPER"/>
    </comp>
    <comp lib="5" loc="(870,290)" name="Hex Digit Display">
      <a name="label" val="HEX_LOWER"/>
    </comp>

    <!-- Status Flags -->
    <comp lib="0" loc="(510,400)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="FLAG_CARRY_8BIT"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="3" loc="(790,440)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(730,460)" name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(840,440)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="FLAG_ZERO"/>
      <a name="output" val="true"/>
    </comp>

    <!-- Wire Connections -->
    <!-- Input to Reg A & Reg B -->
    <wire from="(100,160)" to="(180,160)"/>
    <wire from="(100,240)" to="(180,240)"/>
    <wire from="(240,160)" to="(260,160)"/>
    <wire from="(240,240)" to="(260,240)"/>

    <!-- Mode Select Lines to Steering MUXes -->
    <wire from="(100,80)" to="(340,80)"/>
    <wire from="(340,80)" to="(340,200)"/>
    <wire from="(340,200)" to="(340,280)"/>

    <!-- Splitter connections for A -->
    <wire from="(280,140)" to="(300,140)"/>
    <wire from="(300,140)" to="(300,190)"/>
    <wire from="(300,190)" to="(330,190)"/>
    <wire from="(280,150)" to="(330,170)"/>

    <!-- Splitter connections for B -->
    <wire from="(280,220)" to="(310,220)"/>
    <wire from="(310,220)" to="(310,270)"/>
    <wire from="(310,270)" to="(330,270)"/>
    <wire from="(280,230)" to="(330,250)"/>

    <!-- Custom ALU Input Connections -->
    <wire from="(300,140)" to="(400,140)"/>
    <wire from="(400,140)" to="(440,140)"/>
    <wire from="(310,220)" to="(420,220)"/>
    <wire from="(420,220)" to="(420,150)"/>
    <wire from="(420,150)" to="(440,150)"/>

    <!-- MUX Connections for Custom ALU -->
    <wire from="(480,140)" to="(530,140)"/>
    <wire from="(530,140)" to="(530,160)"/>
    <wire from="(480,200)" to="(530,200)"/>
    <wire from="(480,260)" to="(530,260)"/>
    <wire from="(480,320)" to="(530,320)"/>

    <!-- Upper / 74181 Input Connections -->
    <wire from="(360,180)" to="(400,180)"/>
    <wire from="(400,180)" to="(400,420)"/>
    <wire from="(400,420)" to="(440,420)"/>
    <wire from="(360,260)" to="(420,260)"/>
    <wire from="(420,260)" to="(420,430)"/>
    <wire from="(420,430)" to="(440,430)"/>

    <!-- Carry Propagation from Custom ALU to Upper ALU (Mode 0) -->
    <wire from="(460,120)" to="(460,400)"/>

    <!-- MUX Connections for Upper ALU -->
    <wire from="(480,420)" to="(530,420)"/>
    <wire from="(530,420)" to="(530,440)"/>
    <wire from="(480,480)" to="(530,480)"/>
    <wire from="(480,540)" to="(530,540)"/>
    <wire from="(480,600)" to="(530,600)"/>

    <!-- Opcode distribution -->
    <wire from="(100,340)" to="(550,340)"/>
    <wire from="(550,240)" to="(550,340)"/>
    <wire from="(550,340)" to="(550,520)"/>

    <!-- Comparator Inputs (Custom vs 74181) -->
    <wire from="(570,200)" to="(620,200)"/>
    <wire from="(620,200)" to="(620,250)"/>
    <wire from="(620,250)" to="(640,250)"/>
    <wire from="(620,250)" to="(620,380)"/>
    <wire from="(620,380)" to="(640,380)"/>

    <wire from="(570,480)" to="(630,480)"/>
    <wire from="(630,480)" to="(630,270)"/>
    <wire from="(630,270)" to="(640,270)"/>
    <wire from="(630,270)" to="(630,390)"/>
    <wire from="(630,390)" to="(640,390)"/>

    <!-- Comparator Output -->
    <wire from="(680,260)" to="(740,260)"/>
    <wire from="(740,260)" to="(760,260)"/>

    <!-- 8-Bit Bus to Accumulator Register -->
    <wire from="(660,370)" to="(700,370)"/>
    <wire from="(760,370)" to="(820,370)"/>
    <wire from="(760,370)" to="(770,370)"/>
    <wire from="(770,370)" to="(770,430)"/>
    <wire from="(770,430)" to="(750,430)"/>
    <wire from="(790,440)" to="(840,440)"/>

    <!-- Carry Out 8-Bit -->
    <wire from="(460,400)" to="(510,400)"/>

    <!-- Clock and Control to Registers -->
    <wire from="(80,680)" to="(140,680)"/>
    <wire from="(140,680)" to="(140,180)"/>
    <wire from="(140,180)" to="(180,180)"/>
    <wire from="(140,180)" to="(140,260)"/>
    <wire from="(140,260)" to="(180,260)"/>
    <wire from="(140,260)" to="(140,390)"/>
    <wire from="(140,390)" to="(700,390)"/>

    <wire from="(80,640)" to="(160,640)"/>
    <wire from="(160,640)" to="(160,200)"/>
    <wire from="(160,200)" to="(180,200)"/>
    <wire from="(160,200)" to="(160,280)"/>
    <wire from="(160,280)" to="(180,280)"/>
    <wire from="(160,280)" to="(160,410)"/>
    <wire from="(160,410)" to="(700,410)"/>
  </circuit>
</project>
